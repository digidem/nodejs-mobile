+// mobile: Apple forbids JIT, so the iOS build runs V8 jitless
+// (tools/ios_framework_prepare.sh passes --v8-options=--jitless and
+// --v8-lite-mode) and V8 then exposes no `WebAssembly` global at all. That
+// breaks `fetch()` and everything undici backs (`Response`, `Request`,
+// `WebSocket`, `EventSource`, ...), because undici parses HTTP with a
+// WebAssembly build of llhttp -- the failure is `WebAssembly is not defined`
+// on the first request. Install the bundled pure-JS polyfill (deps/polywasm,
+// which compiles wasm to JS with `new Function`, allowed under jitless) as a
+// stand-in so those work out of the box. See docs/FAQ.md on the patches
+// branch.
+//
+// Runs here rather than in internal/bootstrap/* on purpose: the engine that
+// builds the startup snapshot is the host's, which does have WebAssembly, so
+// the decision has to be made per launch on the target.
+function setupWebAssemblyPolyfill() {
+  // Android keeps V8's own WebAssembly; nothing to do there.
+  if (globalThis.WebAssembly !== undefined) {
+    return;
+  }
+
+  // undici tries the SIMD build of llhttp first and only guards the *compile*
+  // step. polywasm compiles function bodies lazily, so the SIMD module
+  // compiles fine and then throws `Unsupported instruction: 0xFD` on the first
+  // request, well past undici's try/catch. Its documented opt-out picks the
+  // plain build instead; an explicit setting from the embedder still wins.
+  if (process.env.UNDICI_NO_WASM_SIMD === undefined) {
+    process.env.UNDICI_NO_WASM_SIMD = '1';
+  }
+
+  // Lazy: the ~100 KB polyfill is only compiled if something actually touches
+  // WebAssembly. The first get (or a set) swaps the accessor for a plain data
+  // property with V8's own attributes -- writable, non-enumerable,
+  // configurable -- so nothing downstream can tell the difference.
+  const defineValue = (value) => {
+    ObjectDefineProperty(globalThis, 'WebAssembly', {
+      __proto__: null,
+      configurable: true,
+      enumerable: false,
+      writable: true,
+      value,
+    });
+    return value;
+  };
+  ObjectDefineProperty(globalThis, 'WebAssembly', {
+    __proto__: null,
+    configurable: true,
+    enumerable: false,
+    get: function WebAssembly() {
+      return defineValue(loadWebAssemblyPolyfill());
+    },
+    set: defineValue,
+  });
+}
+
+// polywasm implements `CompileError` but neither of the other two error types
+// the WebAssembly JS-API defines. internal/freeze_intrinsics.js reads
+// `WebAssembly.LinkError.prototype` and `WebAssembly.RuntimeError.prototype`
+// with no guard beyond `typeof WebAssembly !== 'undefined'`, so once the
+// polyfill answers for the global, `--frozen-intrinsics` on a jitless engine --
+// the iOS configuration -- fails to *bootstrap* with `Cannot read properties
+// of undefined (reading 'prototype')`. Supplying them also gets their
+// prototypes into the frozen intrinsic list, which is what lets a subclass
+// still write `this.name` on an instance.
+//
+// This lives here and not in deps/polywasm/polywasm.js because
+// tools/dep_updaters/update-polywasm.sh verifies that file byte-for-byte
+// against the bundle published to npm.
+function loadWebAssemblyPolyfill() {
+  const { WebAssembly } = require('internal/deps/polywasm/polywasm');
+  if (WebAssembly.LinkError === undefined) {
+    WebAssembly.LinkError = class LinkError extends Error {
+      constructor(message) {
+        super(message);
+        this.name = 'LinkError';
+      }
+    };
+  }
+  if (WebAssembly.RuntimeError === undefined) {
+    WebAssembly.RuntimeError = class RuntimeError extends Error {
+      constructor(message) {
+        super(message);
+        this.name = 'RuntimeError';
+      }
+    };
+  }
+  return WebAssembly;
+}
+
