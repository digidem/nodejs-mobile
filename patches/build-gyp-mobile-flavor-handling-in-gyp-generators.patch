 tools/gyp/pylib/gyp/generator/make.py  |  38 ++++-----
 tools/gyp/pylib/gyp/generator/ninja.py | 108 ++++++++++++++++---------
 tools/gyp/pylib/gyp/xcode_emulation.py |  17 +++-
 4 files changed, 102 insertions(+), 63 deletions(-)

