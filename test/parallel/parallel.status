#
# Tests that spawn a child node process. They pass here only because the iOS
# *simulator* permits posix_spawn; a shipped app cannot fork or exec, so
# child_process is unusable on the platform and this was never coverage of
# anything an embedder can run. Keeping them green on the simulator bought false
# confidence, and because the spawn is timing-sensitive under load they were also
# the entire flake population -- successive full sweeps failed a different
# handful of test-runner-* each time. Android excludes the same set for the
# harder reason that execPath there is app_process64 and the child SIGABRTs.
#
test-async-hooks-stack-overflow: SKIP
test-async-hooks-stack-overflow-nested-async: SKIP
test-async-hooks-stack-overflow-try-catch: SKIP
test-buffer-constructor-node-modules: SKIP
