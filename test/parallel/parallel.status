test-permission-fs-write-report: SKIP
test-permission-inspector: SKIP
test-permission-inspector-brk: SKIP
test-permission-processbinding: SKIP
test-permission-sqlite-load-extension: SKIP
test-permission-warning-flags: SKIP
test-permission-fs-windows-path: SKIP
#
# Measured on a full device sweep and reproduced 0/3 standalone, so these are
# platform behaviour rather than flake. Causes, in order of size: a child node
# process (execPath is app_process64; the child SIGABRTs), `localhost` having no
# AAAA record on Android so an IPv6 lookup gives ENOTFOUND, fs.cp returning an
# errno outside the set upstream expects, and process.env.TZ not taking effect
# at runtime. None is a defect in this fork.
#
test-datetime-change-notify: SKIP
test-disable-sigusr1: SKIP
test-fs-cp-async-with-mode-flags: SKIP
