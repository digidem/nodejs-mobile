#
# Tests that require more memory than what is usually available on the device,
# causing the app to crash without being handled inside Node.js, and the test
# to hang indefinitely, waiting for the results.
test-blob-buffer-too-large: SKIP
#
# Tests that are less relevant on mobile, although they could be supported
#
test-release-changelog: SKIP # header files not available from mobile apps
test-runner-run: SKIP # some paths were not correct

#
# ---------------------------------------------------------------------------
# Below: measured on a full test/parallel sweep of upstream v24.18.0 run on a
# device (Android arm64 emulator / iOS arm64 simulator), not inferred. Each of
# these spawns a child node process: on Android process.execPath is
# app_process64 rather than node, so the child SIGABRTs; the debugger-probe
# cases drive a child over the inspector protocol. A glob is used only where
# EVERY member of the family fails -- families with passing members are listed
# individually so a working test is never skipped by association.
# ---------------------------------------------------------------------------
#
test-async-hooks-stack-*: SKIP
test-compile-cache-typescript-*: SKIP
test-debugger-probe-*: SKIP
