#
# Tests run under --permission without --allow-fs-write. The harness writes its
# PASS/FAIL verdict to a file from a process.on('exit') hook, and the permission
# model -- correctly -- denies that write, so the verdict never lands and the run
# scores FAIL whatever the test did. Nothing the harness can fix from inside the
# sandbox it is being denied by. See docs/TESTING.md, "How a test PASSes".
#
test-permission-allow-child-process-cli: SKIP
test-permission-fs-write: SKIP
test-permission-fs-windows-path: SKIP
#
# fs.watch's `ignore` option. libuv compiles FSEvents out entirely on iOS --
# "iOS (currently) doesn't provide the FSEvents-API (nor CoreServices)",
# deps/uv/src/unix/fsevents.c -- and falls back to kqueue, which watches a
# directory fd and cannot report WHICH file changed. node's `ignore` filter is
# applied to that filename, so with no usable filename every event is dropped
# and these tests wait forever. Upstream libuv behaviour on the platform, not
# something this fork can fix; recursive watching is unaffected because node
# implements that in JS. Verified against the fork's own macOS host build and
# against Android, where `ignore` works. See docs/TESTING.md, "fs.watch".
#
test-fs-promises-watch-iterator: SKIP
test-fs-watch-ignore-function: SKIP
test-fs-watch-ignore-glob: SKIP
test-fs-watch-ignore-mixed: SKIP
test-fs-watch-ignore-recursive-glob: SKIP
test-fs-watch-ignore-recursive-glob-subdirectories: SKIP
test-fs-watch-ignore-recursive-mixed: SKIP
test-fs-watch-ignore-recursive-regexp: SKIP
test-fs-watch-ignore-regexp: SKIP
test-watch-file-shared-dependency: SKIP
#
